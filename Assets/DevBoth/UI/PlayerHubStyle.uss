.header {
    font-size: 40px;
    -unity-text-align: upper-center;
    color: rgb(254, 202, 129);
    -unity-font-definition: url("project://database/Assets/DevBoth/UI/Fonts/DraftingMono-Bold.otf?fileID=12800000&guid=9edcdbbb09ae8aa46b3612271126dd6b&type=3#DraftingMono-Bold");
    -unity-font-style: bold;
    margin-top: 3%;
    align-items: center;
    justify-content: space-between;
    align-self: center;
    width: 30%;
    height: 15%;
    margin-bottom: 3px;
    -unity-text-outline-color: rgba(115, 67, 58, 0.91);
    -unity-text-outline-width: 5px;
}

.gameSelectorContainer {
    flex-direction: row;
    flex-grow: 1;
    justify-content: center;
    align-self: center;
    align-content: center;
    align-items: center;
}

.levelButton {
    height: 100%;
    padding-left: 0;
    margin-right: 5%;
    margin-left: 5%;
    width: 10%;
    transition-duration: 0.35s;
    justify-content: space-between;
    visibility: visible;
    flex-shrink: 1;
    flex-grow: 0;
    background-image: url("project://database/Assets/DevBoth/Art/ArtByEmma/Menu_6.png?fileID=-985483820&guid=084eede09e9a72b4fb9087a1f9ea2404&type=3#Menu_6_0");
    font-size: 23px;
    -unity-font-definition: url('project://database/Assets/DevJudy/ByOthers/Fonts/KineksRound-Regular.otf?fileID=12800000&guid=7d0f4bf2e8102454aa122a3ddceb6ef8&type=3#KineksRound-Regular');
    -unity-background-image-tint-color: rgb(253, 253, 253);
    background-color: rgba(0, 0, 0, 0);
    -unity-text-align: lower-center;
    -unity-font-style: bold;
    color: rgb(254, 202, 129);
    -unity-text-outline-color: rgb(39, 81, 151);
    -unity-text-outline-width: 0;
    -unity-slice-type: sliced;
    opacity: 1;
    background-size: 100% 100%;
    margin-bottom: 0.5%;
}

.levelButton:hover {
    scale: 1.1 1.1;
}

.hide {
    display: flex;
}

.visible {
}

.button {
    width: 20%;
    -unity-font-definition: url("project://database/Assets/DevBoth/UI/Fonts/DraftingMono-Bold.otf?fileID=12800000&guid=9edcdbbb09ae8aa46b3612271126dd6b&type=3#DraftingMono-Bold");
    -unity-font-style: bold;
    background-image: url("project://database/Assets/DevBoth/Art/ArtByEmma/Menu_6.png?fileID=-985483820&guid=084eede09e9a72b4fb9087a1f9ea2404&type=3#Menu_6_0");
    color: rgb(58, 89, 153);
    height: 13%;
}

.unity-content-and-vertical-scroll-container > #unity-content-viewport > #unity-content-container {
    flex-direction: row;
}

.result-screen-container {
}

.selection-icon {
}

.button:focus {
}

.levelButton:focus {
    scale: 1.1 1.1;
}

#menu-background__container > #main-menu__container > #loading-screen__progress_bar > #unity-progress-bar {
}

.unity-tab__header {
    height: 60px;
    flex-grow: 0;
    width: 20%;
    font-size: 32px;
    -unity-font-definition: url("project://database/Assets/DevBoth/UI/Fonts/DraftingMono-Bold.otf?fileID=12800000&guid=9edcdbbb09ae8aa46b3612271126dd6b&type=3#DraftingMono-Bold");
    -unity-text-align: upper-left;
}

#menu-background__container > #settings-tab-view__container > #unity-tab-view__header-container > #unity-tab__header {
}

.play-button-container {
    width: 25%;
    height: 80%;
    align-content: center;
    align-self: center;
    justify-content: center;
    align-items: center;
}

.play-button-button {
    width: 100%;
    height: 70%;
    background-size: 60% 100%;
    top: 0%;
}

.play-button-label {
    top: 70%;
    bottom: 50%;
    -unity-font-style: bold;
}
