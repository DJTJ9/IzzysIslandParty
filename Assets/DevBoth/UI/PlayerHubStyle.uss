.header {
    font-size: 40px;
    -unity-text-align: upper-center;
    color: rgb(254, 202, 129);
    -unity-font-definition: url("project://database/Assets/DevBoth/UI/Fonts/DraftingMono-Bold.otf?fileID=12800000&guid=9edcdbbb09ae8aa46b3612271126dd6b&type=3#DraftingMono-Bold");
    -unity-font-style: bold;
    margin-top: 3%;
    align-items: center;
    justify-content: space-between;
    align-self: center;
    width: 30%;
    height: 15%;
    margin-bottom: 3px;
}

.gameSelectorContainer {
    flex-direction: row;
    flex-grow: 1;
    justify-content: center;
    align-self: center;
    align-content: center;
    align-items: center;
}

.levelButton {
    height: 80%;
    padding-left: 0;
    margin-right: 5%;
    margin-left: 5%;
    width: 25%;
    transition-duration: 0.35s;
    justify-content: space-between;
    visibility: visible;
    flex-shrink: 1;
    flex-grow: 0;
    background-image: url("project://database/Assets/GUIPackCartoon/Demo/Sprites/Icons/Icons%20Colored/Nature/Palm%20Tree.png?fileID=21300000&guid=053c2fc821996461e9aa35e6df3bfeab&type=3#Palm Tree");
    font-size: 28px;
    -unity-font-definition: url("project://database/Assets/DevBoth/UI/Fonts/DraftingMono-Bold.otf?fileID=12800000&guid=9edcdbbb09ae8aa46b3612271126dd6b&type=3#DraftingMono-Bold");
    -unity-background-image-tint-color: rgb(253, 253, 253);
    background-color: rgba(0, 0, 0, 0);
    -unity-text-align: upper-center;
    -unity-font-style: bold;
    color: rgb(75, 48, 47);
    -unity-text-outline-color: rgb(254, 202, 129);
    -unity-text-outline-width: 1.7px;
    -unity-slice-type: sliced;
    opacity: 1;
}

.levelButton:hover {
    scale: 1.1 1.1;
}

.hide {
    display: flex;
}

.visible {
}

.button {
    width: auto;
    -unity-font-definition: url("project://database/Assets/DevBoth/UI/Fonts/DraftingMono-Bold.otf?fileID=12800000&guid=9edcdbbb09ae8aa46b3612271126dd6b&type=3#DraftingMono-Bold");
    -unity-font-style: bold;
}

.unity-content-and-vertical-scroll-container > #unity-content-viewport > #unity-content-container {
    flex-direction: row;
}

.result-screen-container {
}

.selection-icon {
}

.button:focus {
}

.levelButton:focus {
    scale: 1.1 1.1;
}

#menu-background__container > #main-menu__container > #loading-screen__progress_bar > #unity-progress-bar {
}

.unity-tab__header {
    height: 60px;
    flex-grow: 0;
    width: 20%;
    font-size: 32px;
    -unity-font-definition: url("project://database/Assets/DevBoth/UI/Fonts/DraftingMono-Bold.otf?fileID=12800000&guid=9edcdbbb09ae8aa46b3612271126dd6b&type=3#DraftingMono-Bold");
    -unity-text-align: upper-left;
}

#menu-background__container > #settings-tab-view__container > #unity-tab-view__header-container > #unity-tab__header {
}
