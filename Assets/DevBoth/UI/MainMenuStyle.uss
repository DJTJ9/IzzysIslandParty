.header {
    font-size: 100px;
    color: rgb(255, 255, 255);
    margin-top: 3%;
    margin-bottom: 3%;
    width: 30%;
    height: 10%;
}

.button {
    justify-content: space-between;
    align-self: center;
    width: 15%;
    height: 7%;
    margin-top: 2%;
    font-size: 20px;
    -unity-text-align: middle-center;
    text-overflow: ellipsis;
    transition-duration: 0.35s;
    -unity-font-style: bold;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-ThinItalic');
}

.button:hover {
    scale: 1.1 1.1;
}
