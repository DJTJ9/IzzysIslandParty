.header {
    font-size: 100px;
    color: rgb(255, 255, 255);
    margin-top: 3%;
    margin-bottom: 3%;
    width: 30%;
    height: 10%;
    -unity-font-definition: url("project://database/Assets/DevBoth/UI/Fonts/DraftingMono-Bold.otf?fileID=12800000&guid=9edcdbbb09ae8aa46b3612271126dd6b&type=3#DraftingMono-Bold");
}

.button {
    justify-content: space-between;
    align-self: center;
    width: 20%;
    height: 7%;
    margin-top: 2%;
    font-size: 20px;
    -unity-text-align: middle-center;
    text-overflow: ellipsis;
    transition-duration: 0.35s;
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/DevBoth/UI/Fonts/DraftingMono-Bold.otf?fileID=12800000&guid=9edcdbbb09ae8aa46b3612271126dd6b&type=3#DraftingMono-Bold");
    background-image: url("project://database/Assets/DevBoth/Art/FREE%20KAWAII%20GUI%20PACK/PNG/Pannel-Button.png?fileID=-2033803903&guid=bf4c5e583cfa0f14dbdf1dbbf52c7fa2&type=3#Pannel-Button_10");
    background-color: rgba(255, 255, 255, 0);
}

.button:hover {
    scale: 1.1 1.1;
}
