<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/DevBoth/UI/PlayerHubStyle.uss?fileID=7433441132597879392&amp;guid=185d7323de5cef446995f46ef11fa6c4&amp;type=3#PlayerHubStyle" />
    <Style src="project://database/Assets/DevBoth/UI/MainMenuStyle.uss?fileID=7433441132597879392&amp;guid=1f48fc2225c4d6748a3d12140f2529a0&amp;type=3#MainMenuStyle" />
    <ui:VisualElement name="menu-background__container" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Suriyun/Yippy%20Kawaii/UI/bearbg.png?fileID=21300000&amp;guid=3d29693681072574aa13f942091f8d4e&amp;type=3#bearbg&quot;); display: none;">
        <ui:VisualElement name="main-menu__container" style="flex-grow: 1; display: none;">
            <ui:Label text="MAIN MENU" name="main-menu-header__label" class="header" style="width: 50%; height: 20%;" />
            <ui:Button text="PLAY" name="main-menu-play__button" class="button" />
            <ui:Button text="SETTINGS" name="main-menu-settings__button" class="button" />
            <ui:Button text="QUIT" name="main-menu-quit__button" class="button" />
        </ui:VisualElement>
        <ui:VisualElement name="player-hub__container" style="flex-grow: 1; flex-direction: column; display: none; visibility: visible;">
            <ui:VisualElement name="player-hub-top__container" style="flex-grow: 1;">
                <ui:Label text="SELECT LEVEL" name="player-hub-header__label" class="header" />
            </ui:VisualElement>
            <ui:VisualElement name="player-hub-middle__container" style="flex-grow: 1; height: 70%;">
                <ui:VisualElement name="player-hub-middle-first-row__container" class="gameSelectorContainer" style="width: 90%; justify-content: center;">
                    <ui:Button text="Bowling Battle" name="play-bowling-battle__button" class="levelButton" />
                    <ui:Button text="Fishing Frenzy" name="play-fishing-frenzy__button" class="levelButton" />
                    <ui:Button text="Jetski Joyride" name="play-jetski-joyride__button" class="levelButton" />
                </ui:VisualElement>
                <ui:VisualElement name="player-hub-middle-second-row__container" class="gameSelectorContainer" style="width: 90%;">
                    <ui:Button text="Minigolf Mayhem" name="play-minigolf-mayhem__button" class="levelButton" style="overflow: visible;" />
                    <ui:Button text="Swaggy Snapshots" name="play-swaggy-snapshots__button" class="levelButton" />
                    <ui:Button text="To be added..." class="levelButton" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="player-hub-bottom__container" style="flex-grow: 1; align-items: center; display: flex; visibility: visible;">
                <ui:Button text="BACK" name="player-hub-back__button" class="levelButton" style="background-image: none;" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="settings-menu__container" style="flex-grow: 1; display: none;">
            <ui:Label text="SETTINGS" name="settings-header__label" class="header" />
            <ui:Button text="BACK" name="settings-menu-back__button" class="button" style="justify-content: flex-start; display: flex;" />
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="pause-menu__container" style="flex-grow: 1; display: none;">
        <ui:Label text="PAUSE MENU" name="pause-menu-header__label" class="header" style="width: 50%; height: 20%;" />
        <ui:Button text="RESUME" name="pause-menu-resume__button" class="button" />
        <ui:Button text="RESTART" name="pause-menu-restart__button" class="button" />
        <ui:Button text="CHANGE LEVEL" name="pause-menu-change-level__button" parse-escape-sequences="true" class="button" />
        <ui:Button text="QUIT" name="pause-menu-quit__button" class="button" />
    </ui:VisualElement>
</ui:UXML>
