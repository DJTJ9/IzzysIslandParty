                                <ui:Label text="HOLD&#10;" name="rear-view-instruction-gamepad__label" style="-unity-text-align: upper-center; -unity-font-style: bold; -unity-font-definition: url(&quot;project://database/Assets/DevBoth/UI/Fonts/DraftingMono-Bold.ttf?fileID=12800000&amp;guid=e4fdbc00f3d687341940b8781faf40d2&amp;type=3#DraftingMono-Bold&quot;); height: 10%;" />
                                <ui:VisualElement name="rear-view-instruction-gamepad__icon" style="flex-grow: 1; flex-shrink: 1; width: 100%; height: 80%; min-width: 100%; min-height: 80%; max-width: 100%; max-height: 80%; background-image: url(&quot;project://database/Assets/DevBoth/Art/Input%20Sprites%20for%20TextMesh%20Pro/all_input.png?fileID=1326238866&amp;guid=069a00c4a21d8654bbe27600f3ba7103&amp;type=3#rt&quot;); background-size: 35% 80%; -unity-text-align: middle-right; align-content: center; align-self: flex-end; justify-content: flex-end; align-items: auto; flex-direction: row;" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:Label text=" REAR VIEW" name="rear-view-instruction__label" style="width: 50%; height: 100%; min-width: 50%; min-height: 100%; max-width: 50%; max-height: 100%; align-self: flex-start; align-items: flex-start; justify-content: center; -unity-text-align: middle-left; font-size: 38px; -unity-font-definition: url(&quot;project://database/Assets/DevBoth/UI/Fonts/DraftingMono-Bold.otf?fileID=12800000&amp;guid=9edcdbbb09ae8aa46b3612271126dd6b&amp;type=3#DraftingMono-Bold&quot;); -unity-font-style: bold; color: rgb(255, 255, 255); -unity-text-outline-width: 4px; -unity-text-outline-color: rgba(0, 0, 0, 0.9);" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="hh-controls__container" style="flex-grow: 1; flex-wrap: nowrap; flex-shrink: 0; height: 80%; min-height: 80%; max-height: 80px; justify-content: flex-start; display: none; width: 100%; min-width: 100%; max-width: 100%;">
                    <ui:VisualElement name="jump-instruction__container" style="flex-grow: 1; flex-direction: row; width: 100%; justify-content: center; align-content: center; min-width: 100%; min-height: 32%; max-width: 100%; max-height: 32%; height: 32%; align-self: center; background-size: 100% 100%; flex-shrink: 0; background-color: rgba(254, 202, 129, 0); background-image: url(&quot;project://database/Assets/DevBoth/Art/FREE%20KAWAII%20GUI%20PACK/Mega%20Panel%20Pack.png?fileID=847039328&amp;guid=971f2918c9e53214facdd4d1241b39b3&amp;type=3#Mega Panel Pack_21&quot;);">
                        <ui:VisualElement name="jump-instruction__container" style="flex-grow: 0; width: 50%; min-width: 50%; max-width: 50%; flex-direction: row; height: 69%; align-self: center; justify-content: flex-end; align-items: flex-end; align-content: flex-end;">
                            <ui:VisualElement name="jump-instruction-keyboard__icon" style="flex-grow: 0; flex-shrink: 0; width: 20%; height: 100%; min-width: 20%; min-height: 100%; max-width: 20%; max-height: 100%; background-image: url(&quot;project://database/Assets/DevBoth/Art/Input%20Sprites%20for%20TextMesh%20Pro/all_input.png?fileID=131068488&amp;guid=069a00c4a21d8654bbe27600f3ba7103&amp;type=3#ku&quot;); background-size: 100% 80%; -unity-text-align: middle-right; align-content: center; align-self: flex-end; justify-content: flex-end; align-items: auto; flex-direction: column; display: flex;" />
                            <ui:VisualElement name="jump-instruction-keyboard__icon" style="flex-grow: 0; flex-shrink: 0; width: 50%; height: 100%; min-width: 50%; min-height: 100%; max-width: 50%; max-height: 100%; background-image: url(&quot;project://database/Assets/DevBoth/Art/Input%20Sprites%20for%20TextMesh%20Pro/all_input.png?fileID=-1476951808&amp;guid=069a00c4a21d8654bbe27600f3ba7103&amp;type=3#space&quot;); background-size: 80% 80%; -unity-text-align: middle-right; align-content: center; align-self: flex-end; justify-content: flex-end; align-items: auto; flex-direction: column;" />
                            <ui:VisualElement name="space-holder" style="flex-grow: 1; width: 7%; min-width: 7%; max-width: 7%;" />
                            <ui:VisualElement name="jump-instruction-gamepad__icon" style="flex-grow: 1; flex-shrink: 1; width: 20%; height: 100%; min-width: 20%; min-height: 100%; max-width: 20%; max-height: 100%; background-image: url(&quot;project://database/Assets/DevBoth/Art/Input%20Sprites%20for%20TextMesh%20Pro/all_input.png?fileID=-725581648&amp;guid=069a00c4a21d8654bbe27600f3ba7103&amp;type=3#xa&quot;); background-size: 100% 80%; -unity-text-align: middle-right; align-content: center; align-self: flex-end; justify-content: flex-end; align-items: auto; flex-direction: row;" />
                        </ui:VisualElement>
                        <ui:Label text="    JUMP" name="jump-instruction__label" double-click-selects-word="false" style="width: 40%; height: 100%; min-width: 40%; min-height: 100%; max-width: 40%; max-height: 100%; align-self: flex-start; align-items: flex-start; justify-content: center; -unity-text-align: middle-left; font-size: 38px; -unity-font-definition: url(&quot;project://database/Assets/DevBoth/UI/Fonts/DraftingMono-Bold.otf?fileID=12800000&amp;guid=9edcdbbb09ae8aa46b3612271126dd6b&amp;type=3#DraftingMono-Bold&quot;); -unity-font-style: bold; color: rgb(255, 255, 255); -unity-text-outline-width: 4px; -unity-text-outline-color: rgba(0, 0, 0, 0.9);" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="controller-selection-bottom__container" style="flex-grow: 0; height: 35%; align-self: center; justify-content: center; align-items: center; width: 100%; flex-shrink: 0; min-height: 35%; max-height: 35%; margin-top: 0.5%; flex-direction: row; display: flex;">
            <ui:VisualElement name="game-instruction-text__container" style="flex-grow: 1; width: 60%; min-width: 60%; max-width: 60%; height: 100%; min-height: 100%; max-height: 100%; flex-direction: row; align-self: flex-end; justify-content: flex-start; align-content: flex-start; align-items: flex-start; left: 0%; right: 0%;">
                <ui:VisualElement name="space-holder" style="flex-grow: 1; background-image: none; width: 3%; height: 80%; min-height: 80%; max-height: 80%; margin-right: 6%; margin-left: 0%; justify-content: center; align-items: center; align-self: center; align-content: center; min-width: 3%; max-width: 3%; display: flex;" />
                <ui:VisualElement name="bb-game-instruction-text__label" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/DevBoth/Art/FREE%20KAWAII%20GUI%20PACK/Mega%20Panel%20Pack.png?fileID=-735993084&amp;guid=971f2918c9e53214facdd4d1241b39b3&amp;type=3#Mega Panel Pack_2&quot;); margin-right: 0%; padding-right: 0%; align-self: center; justify-content: flex-start; align-items: stretch; align-content: flex-start; flex-direction: row; width: 80%; min-width: 80%; max-width: 80%; display: flex;">
                    <ui:Label text=" &#10; &#10;  Choose a starting position and drop a ball down an &#10;  obstacle-filled lane to knock over as many pins as &#10;  possible. &#10;  Different balls give different points per pin, &#10;  so pick wisely to maximize your score.&#10; &#10; &#10; " name="Label" emoji-fallback-support="true" style="justify-content: flex-start; align-self: flex-start; align-content: center; align-items: center; display: flex; -unity-text-align: middle-left; font-size: 27px; -unity-font-definition: url(&quot;project://database/Assets/Plugins/AllIn1SpriteShader/Demo/Fonts/CaviarDreams.ttf?fileID=12800000&amp;guid=8125849ac2a1e6742b3cad98aa210e2d&amp;type=3#CaviarDreams&quot;); background-image: none; background-size: 100% 100%; -unity-background-scale-mode: scale-and-crop; width: 70%; min-width: 70%; max-width: 70%; -unity-font-style: bold;" />
                </ui:VisualElement>
                <ui:VisualElement name="ff-game-instruction-text__label" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/DevBoth/Art/FREE%20KAWAII%20GUI%20PACK/PNG/Pannel-Button.png?fileID=1357002692&amp;guid=bf4c5e583cfa0f14dbdf1dbbf52c7fa2&amp;type=3#Pannel-Button_24&quot;); margin-right: 0%; padding-right: 0%; align-self: center; justify-content: flex-start; align-items: stretch; align-content: flex-start; flex-direction: row; width: 80%; min-width: 80%; max-width: 80%; display: none;">
                    <ui:Label text="  &#10;&#10;  Catch as many fish as possible by completing different &#10;  quick time events. Rare fish will have harder combos, &#10;  but give you more points too, so be smart about which &#10;  ones to catch and which ones to let go. Whoever has the &#10;  most points after the timer runs out wins!&#10;  &#10;  &#10; " name="Label" style="justify-content: flex-start; align-self: flex-start; align-content: center; align-items: center; display: flex; -unity-text-align: middle-left; font-size: 26px; -unity-font-definition: url(&quot;project://database/Assets/DevBoth/UI/Fonts/DraftingMono-Bold.otf?fileID=12800000&amp;guid=9edcdbbb09ae8aa46b3612271126dd6b&amp;type=3#DraftingMono-Bold&quot;); background-image: none; background-size: 100% 100%; -unity-background-scale-mode: scale-and-crop; width: 70%; min-width: 70%; max-width: 70%;" />
                </ui:VisualElement>
                <ui:VisualElement name="jj-race-game-instruction-text__label" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/DevBoth/Art/FREE%20KAWAII%20GUI%20PACK/PNG/Pannel-Button.png?fileID=1357002692&amp;guid=bf4c5e583cfa0f14dbdf1dbbf52c7fa2&amp;type=3#Pannel-Button_24&quot;); margin-right: 0%; padding-right: 0%; align-self: center; justify-content: flex-start; align-items: stretch; align-content: flex-start; flex-direction: row; width: 80%; min-width: 80%; max-width: 80%; display: none;">
                    <ui:Label text="  &#10;&#10;  Race your fellow players through the ocean and be &#10;  the first to cross the finish line! But watch out for &#10;  obstacles, you don&apos;t want to lose speed by running &#10;  into any stones - or other players.&#10;  &#10;  &#10; " name="Label" style="justify-content: flex-start; align-self: flex-start; align-content: center; align-items: center; display: flex; -unity-text-align: middle-left; font-size: 27px; -unity-font-definition: url(&quot;project://database/Assets/DevBoth/UI/Fonts/DraftingMono-Bold.otf?fileID=12800000&amp;guid=9edcdbbb09ae8aa46b3612271126dd6b&amp;type=3#DraftingMono-Bold&quot;); background-image: none; background-size: 100% 100%; -unity-background-scale-mode: scale-and-crop; width: 70%; min-width: 70%; max-width: 70%;" />
                </ui:VisualElement>
                <ui:VisualElement name="jj-slalom-game-instruction-text__label" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/DevBoth/Art/FREE%20KAWAII%20GUI%20PACK/PNG/Pannel-Button.png?fileID=1357002692&amp;guid=bf4c5e583cfa0f14dbdf1dbbf52c7fa2&amp;type=3#Pannel-Button_24&quot;); margin-right: 0%; padding-right: 0%; align-self: center; justify-content: flex-start; align-items: stretch; align-content: flex-start; flex-direction: row; width: 80%; min-width: 80%; max-width: 80%; display: none;">
                    <ui:Label text="  &#10;&#10;  Test your steering skills by racing your fellow &#10;  players through the slalom. Miss a goal and you&apos;ll &#10;  get a time penalty. So being the first isn&apos;t all to &#10;  strive for, not missing any goals is just as important &#10;  as driving through the track quickly!&#10;  &#10;  &#10; " name="Label" style="justify-content: flex-start; align-self: flex-start; align-content: center; align-items: center; display: flex; -unity-text-align: middle-left; font-size: 26px; -unity-font-definition: url(&quot;project://database/Assets/DevBoth/UI/Fonts/DraftingMono-Bold.otf?fileID=12800000&amp;guid=9edcdbbb09ae8aa46b3612271126dd6b&amp;type=3#DraftingMono-Bold&quot;); background-image: none; background-size: 100% 100%; -unity-background-scale-mode: scale-and-crop; width: 70%; min-width: 70%; max-width: 70%;" />
                </ui:VisualElement>
                <ui:VisualElement name="mm-classic-game-instruction-text__label" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/DevBoth/Art/FREE%20KAWAII%20GUI%20PACK/PNG/Pannel-Button.png?fileID=1357002692&amp;guid=bf4c5e583cfa0f14dbdf1dbbf52c7fa2&amp;type=3#Pannel-Button_24&quot;); margin-right: 0%; padding-right: 0%; align-self: center; justify-content: flex-start; align-items: stretch; align-content: flex-start; flex-direction: row; width: 80%; min-width: 80%; max-width: 80%; display: none;">
                    <ui:Label text="  &#10;&#10;  You play as a ball on a chaotic mini-golf course &#10;  filled with traps and towering titans trying to stop &#10;  your progress. Knock rival balls into hazards while &#10;  carefully planning each shot. The goal is simple: &#10;  Reach the hole with as few shots as possible!&#10;  &#10;  &#10; " name="Label" style="justify-content: flex-start; align-self: flex-start; align-content: center; align-items: center; display: flex; -unity-text-align: middle-left; font-size: 27px; -unity-font-definition: url(&quot;project://database/Assets/DevBoth/UI/Fonts/DraftingMono-Bold.otf?fileID=12800000&amp;guid=9edcdbbb09ae8aa46b3612271126dd6b&amp;type=3#DraftingMono-Bold&quot;); background-image: none; background-size: 100% 100%; -unity-background-scale-mode: scale-and-crop; width: 70%; min-width: 70%; max-width: 70%;" />
                </ui:VisualElement>
                <ui:VisualElement name="mm-race-game-instruction-text__label" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/DevBoth/Art/FREE%20KAWAII%20GUI%20PACK/PNG/Pannel-Button.png?fileID=1357002692&amp;guid=bf4c5e583cfa0f14dbdf1dbbf52c7fa2&amp;type=3#Pannel-Button_24&quot;); margin-right: 0%; padding-right: 0%; align-self: center; justify-content: flex-start; align-items: stretch; align-content: flex-start; flex-direction: row; width: 80%; min-width: 80%; max-width: 80%; display: none;">
                    <ui:Label text="  &#10;&#10;  Race across a dangerous course where traps, titans &#10;  and rival players stand in your way. Use skill &#10;  - and aggression - to clear the path and reach the &#10;  hole fast. &#10;  Victory belongs to the player that finishes first!&#10;  &#10;  &#10; " name="Label" style="justify-content: flex-start; align-self: flex-start; align-content: center; align-items: center; display: flex; -unity-text-align: middle-left; font-size: 27px; -unity-font-definition: url(&quot;project://database/Assets/DevBoth/UI/Fonts/DraftingMono-Bold.otf?fileID=12800000&amp;guid=9edcdbbb09ae8aa46b3612271126dd6b&amp;type=3#DraftingMono-Bold&quot;); background-image: none; background-size: 100% 100%; -unity-background-scale-mode: scale-and-crop; width: 70%; min-width: 70%; max-width: 70%;" />
                </ui:VisualElement>
                <ui:VisualElement name="ss-game-instruction-text__label" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/DevBoth/Art/FREE%20KAWAII%20GUI%20PACK/PNG/Pannel-Button.png?fileID=1357002692&amp;guid=bf4c5e583cfa0f14dbdf1dbbf52c7fa2&amp;type=3#Pannel-Button_24&quot;); margin-right: 0%; padding-right: 0%; align-self: center; justify-content: flex-start; align-items: stretch; align-content: flex-start; flex-direction: row; width: 80%; min-width: 80%; max-width: 80%; display: none;">
                    <ui:Label text="  &#10;&#10;  Take a photo within a limited time. Each animal on &#10;  your polaroid earns points if it&apos;s facing the camera, &#10;  looks happy and/or performs a cool dance move.&#10;  The player with the highest-scoring photo wins!&#10;  &#10;  &#10; " name="Label" style="justify-content: flex-start; align-self: flex-start; align-content: center; align-items: center; display: flex; -unity-text-align: middle-left; font-size: 27px; -unity-font-definition: url(&quot;project://database/Assets/DevBoth/UI/Fonts/DraftingMono-Bold.otf?fileID=12800000&amp;guid=9edcdbbb09ae8aa46b3612271126dd6b&amp;type=3#DraftingMono-Bold&quot;); background-image: none; background-size: 100% 100%; -unity-background-scale-mode: scale-and-crop; width: 70%; min-width: 70%; max-width: 70%;" />
                </ui:VisualElement>
                <ui:VisualElement name="hh-game-instruction-text__label" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/DevBoth/Art/FREE%20KAWAII%20GUI%20PACK/PNG/Pannel-Button.png?fileID=1357002692&amp;guid=bf4c5e583cfa0f14dbdf1dbbf52c7fa2&amp;type=3#Pannel-Button_24&quot;); margin-right: 0%; padding-right: 0%; align-self: center; justify-content: flex-start; align-items: stretch; align-content: flex-start; flex-direction: row; width: 80%; min-width: 80%; max-width: 80%; display: none;">
                    <ui:Label text="  &#10;&#10;  On your markers, ready, set, go! When the race starts &#10;  you must make sure to jump over the upcoming obstacles&#10;  in time, because they let you trip and loose your speed. &#10;  Pressing the jump-button for longer makes you jump a &#10;  wider distance, but keep in mind, this isn&apos;t always &#10;  ideal. The first to cross the finish line wins!&#10;  &#10;  &#10; " name="Label" style="justify-content: flex-start; align-self: flex-start; align-content: center; align-items: center; display: flex; -unity-text-align: middle-left; font-size: 26px; -unity-font-definition: url(&quot;project://database/Assets/DevBoth/UI/Fonts/DraftingMono-Bold.otf?fileID=12800000&amp;guid=9edcdbbb09ae8aa46b3612271126dd6b&amp;type=3#DraftingMono-Bold&quot;); background-image: none; background-size: 100% 100%; -unity-background-scale-mode: scale-and-crop; width: 70%; min-width: 70%; max-width: 70%;" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="controller-selection-ready-button__container" style="flex-grow: 1; height: 100%; align-self: center; width: 0%; min-width: 0%; max-width: 0%; display: flex;">
                <ui:VisualElement name="space-holder" style="flex-grow: 1;" />
                <ui:VisualElement name="space-holder" style="flex-grow: 1; width: 100%; height: 80%; min-height: 80%; max-height: 100%;" />
                <ui:Button text="&#10;" name="controller-selection-ready__button" class="button" style="height: 1px; width: 1px; margin-top: 40%; background-image: url(&quot;project://database/Assets/GUIPackCartoon/Demo/Sprites/Icons/Icons%20Colored/Emojis/Cartoon/Big%20Smile%20-%20Cartoon.png?fileID=21300000&amp;guid=4ec405a8722884cec81482c45cd5f241&amp;type=3#Big Smile - Cartoon&quot;); background-size: 100% 100%; margin-left: 0%; -unity-text-outline-width: 3px; -unity-text-outline-color: rgba(0, 0, 0, 0.9); color: rgb(254, 202, 129); font-size: 24px; background-color: rgba(255, 255, 255, 0); -unity-background-image-tint-color: rgb(255, 255, 255); scale: 1 1; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; overflow: visible;" />
