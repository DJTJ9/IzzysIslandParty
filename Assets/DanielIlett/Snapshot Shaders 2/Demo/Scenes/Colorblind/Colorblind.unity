PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 0}
    m_Modifications:
    - target: {fileID: 2228988548145697899, guid: 08988851fcf88394aa37e740ea678fa0, type: 3}
      propertyPath: m_text
      value: The Colorblind Effect
      objectReference: {fileID: 0}
    - target: {fileID: 2545972194885697556, guid: 08988851fcf88394aa37e740ea678fa0, type: 3}
      propertyPath: m_text
      value: 'This shader filters the screen to approximate how your game will look
        to people with various types of color vision deficiency.


        Note that
        this is not a medical diagnostic tool! The intention is to give you an idea
        at a quick glace if your game may have readability problems for colorblind
        people.


        If you notice any objects which are hard to distinguish
        when using these filters, please consult a professional tool to confirm your
        findings.


        This effect supports various colorblind filters.'
      objectReference: {fileID: 0}
